# ═══════════════════════════════════════════════════════════════════════════
#  MR ADS TG AUTOMATION — environment variables (PLACEHOLDERS ONLY)
#  Copy to .env for local use, or paste these keys into Railway → Variables.
#  Never commit a real .env file to GitHub.
# ═══════════════════════════════════════════════════════════════════════════

# ── Required in production ─────────────────────────────────────────────────
# Flask session signing key. Use a long random string (48+ chars).
SECRET_KEY=replace-with-a-long-random-string

# Dashboard admin password (username: admin).
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# ── Database (Neon PostgreSQL — persistent storage) ────────────────────────
# Paste the connection string Neon gives you. Both postgres:// and
# postgresql:// are accepted; ?sslmode=require is added automatically.
# Leave empty to fall back to local SQLite (data is lost on redeploy).
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Import an old local SQLite file into PostgreSQL: 0 = off (default),
# 1 = always, auto = only when the target database has no users yet.
MIGRATE_SQLITE=0

# ── Optional: Telegram API credentials (per-user values live in the DB) ────
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=replace-with-your-api-hash

# ── Optional: server / limits ──────────────────────────────────────────────
PORT=5000
# Max channels per Auto Video Poster campaign (UI and backend share this value)
MAX_AUTO_POST_CHANNELS=50
# Max request/upload size in MB (ZIP uploads)
MAX_UPLOAD_MB=500
# 1 = allow public /register sign-up (default 0 = admin-created accounts only)
ALLOW_REGISTRATION=0
# 0 = do not start background schedulers in this process
BACKGROUND_JOBS_ENABLED=1
# Minutes after which a stuck campaign is treated as interrupted
STALE_TASK_MINUTES=30
# How many Saved Messages to scan when building a Saved Messages campaign.
# CAREFUL: the scan is newest-first, so any videos forwarded into Saved Messages
# OLDER than this number are silently left out of the campaign. 800 was a trap for
# a library of thousands of forwarded videos. Raise it to at least your library
# size (0 = unlimited).
SAVED_MESSAGES_SCAN_LIMIT=100000
